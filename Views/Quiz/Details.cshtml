@{
}
@model Asistencia.Models.Gamification.Quiz
@{
    ViewData["Title"] = "Detalles del Cuestionario";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary mb-2">
                <i class="fas fa-arrow-left me-1"></i> Volver a mis Cuestionarios
            </a>
            <h2 class="fw-bold mb-0 text-primary">@Model.Title</h2>
            <p class="text-muted mb-0"><i class="fas fa-book me-2"></i> Asignatura de tu curso actual</p>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.QuizId" class="btn btn-outline-primary btn-sm">
                <i class="fas fa-edit me-2"></i> Editar
            </a>

            <button type="button" class="btn btn-success btn-sm shadow text-white fw-bold" data-bs-toggle="modal" data-bs-target="#gameSessionModal">
                <i class="fas fa-play-circle me-2"></i> Jugar en Vivo
            </button>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-light h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                        <i class="fas fa-question fs-4"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-0">Total de Preguntas</h6>
                        <h3 class="fw-bold mb-0">@Model.Questions.Count</h3>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-light h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                        <i class="fas fa-stopwatch fs-4"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-0">Tiempo Estimado</h6>
                        <h3 class="fw-bold mb-0">@(Model.Questions.Sum(q => q.TimeLimitSecond) / 60) Minutos</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom py-3">
            <h5 class="fw-bold mb-0"><i class="fas fa-list-ol text-primary me-2"></i> Contenido del Cuestionario</h5>
        </div>
        <div class="card-body p-0">
            <div class="accordion accordion-flush" id="questionsAccordion">

                @foreach (var (question, index) in Model.Questions.Select((q, i) => (q, i)))
                {
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="heading-@question.QuestionId">
                            <button class="accordion-button collapsed fw-bold text-dark" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@question.QuestionId">
                                <span class="me-3 badge bg-secondary">@(index + 1)</span> @question.Text
                            </button>
                        </h2>
                        <div id="collapse-@question.QuestionId" class="accordion-collapse collapse" data-bs-parent="#questionsAccordion">
                            <div class="accordion-body bg-light border-top">

                                <div class="d-flex justify-content-between mb-3 text-muted small">
                                    <span><i class="fas fa-clock me-1"></i> @question.TimeLimitSecond segundos</span>
                                    <span><i class="fas fa-star me-1 text-warning"></i> @question.Point puntos base</span>
                                </div>

                                <div class="row g-2">
                                    @foreach (var option in question.AnserOptions)
                                    {
                                        // Resaltar la respuesta correcta en verde
                                        var borderClass = option.IsCorrect ? "border-success bg-success bg-opacity-10 fw-bold" : "border-secondary bg-white";
                                        var iconClass = option.IsCorrect ? "fa-check-circle text-success" : "fa-circle text-muted";

                                        <div class="col-md-6">
                                            <div class="p-2 border rounded @borderClass d-flex align-items-center">
                                                <i class="fas @iconClass me-2"></i>
                                                <span>@option.Text</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="gameSessionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">

            <div class="modal-header bg-primary text-white border-0 rounded-top-4">
                <h5 class="modal-title fw-bold">
                    <i class="fas fa-gamepad me-2"></i> Configurar Partida
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-controller="Gamification" asp-action="CreateSession" method="post">
                <div class="modal-body p-4">

                    <div class="text-center mb-4">
                        <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                            <i class="fas fa-users fa-3x text-primary"></i>
                        </div>
                        <h6 class="fw-bold text-dark">Lanzar al Salón de Clases</h6>
                        <p class="text-muted small">Generaremos un código PIN único para que los estudiantes se unan desde sus teléfonos móviles.</p>
                    </div>

                    <input type="hidden" name="quizId" value="@Model.QuizId" />

                    <div class="card border-0 bg-light p-3 rounded-3 mb-3">
                        <h6 class="fw-bold fs-6 mb-3 text-secondary text-uppercase">Opciones</h6>

                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="randomize" name="randomizeQuestions" value="true">
                            <label class="form-check-label ms-2" for="randomize">Preguntas en orden aleatorio</label>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-0 pt-0 pb-4 px-4 d-flex justify-content-between">
                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success px-4 fw-bold shadow">
                        Generar PIN y Empezar <i class="fas fa-arrow-right ms-2"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>