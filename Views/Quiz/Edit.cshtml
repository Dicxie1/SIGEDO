@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model Asistencia.Models.Gamification.Quiz

@{
    ViewData["Title"] = "Editar Cuestionario";
    string[] colores = { "ans-red", "ans-blue", "ans-yellow", "ans-green" };
}

<style>
    .ans-red { border-left: 5px solid #E21B3C; }
    .ans-blue { border-left: 5px solid #1368CE; }
    .ans-yellow { border-left: 5px solid #D89E00; }
    .ans-green { border-left: 5px solid #26890C; }
    .question-card { transition: all 0.3s ease; }
</style>

<div class="container py-4">
   <div class="row ">
       <div class="col-lg-8 col-md-7" >
            <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 class="fw-bold text-dark"><i class="fas fa-edit text-primary me-2"></i> Editar Cuestionario</h2>
        <button type="button" class="btn btn-outline-primary" onclick="addQuestion()">
            <i class="fas fa-plus me-1"></i> Agregar Nueva Pregunta
        </button>
    </div>

    <form asp-action="Edit" method="post" id="quizForm">
        
        <input type="hidden" asp-for="QuizId" />

        <div class="card border-0 shadow-sm mb-2">
            <div class="card-body p-2">
                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-bold text-muted small">Título del Juego</label>
                    <input asp-for="Title" class="form-control form-control-sm fw-bold" required />
                </div>
            </div>
        </div>

        <div id="questionsContainer">
            @for (int i = 0; i < Model.Questions.Count; i++)
            {
                <div class="card border-0 shadow-sm mb-2 question-card" id="question_@i">
                    
                    <input type="hidden" asp-for="Questions[i].QuestionId" />
                    <input type="hidden" asp-for="Questions[i].QuizId" />

                    <div class="card-header bg-white border-bottom-0 pt-2 pb-0 d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold text-primary mb-0"><i class="fas fa-question-circle me-1"></i> Pregunta <span class="q-number">@(i + 1)</span></h5>
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeQuestion(@i)">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>

                    <div class="card-body p-2">
                        <div class="mb-2">
                            <input type="text" asp-for="Questions[i].Text" class="form-control form-control-sm border-2" required />
                        </div>

                        <div class="row g-3 mb-4 text-muted small">
                            <div class="col-md-6 d-flex align-items-center">
                                <i class="fas fa-stopwatch me-2 fs-5"></i>
                                <select asp-for="Questions[i].TimeLimitSecond" class="form-select form-select-sm w-auto border-0 bg-light fw-bold">
                                    <option value="10">10 Segundos</option>
                                    <option value="20">20 Segundos</option>
                                    <option value="30">30 Segundos</option>
                                    <option value="60">1 Minuto</option>
                                </select>
                            </div>
                            <div class="col-md-6 d-flex align-items-center justify-content-end">
                                <i class="fas fa-star me-2 fs-5 text-warning"></i>
                                <input type="number" asp-for="Questions[i].Point" class="form-control form-control-sm w-auto border-0 bg-light fw-bold" /> pts
                            </div>
                        </div>

                        <div class="row g-3">
                            @for (int j = 0; j < 4; j++)
                            {
                                <input type="hidden" asp-for="Questions[i].AnserOptions[j].AnwerOptionId" />
                                <input type="hidden" asp-for="Questions[i].AnserOptions[j].QuestionId" />
                                <input type="hidden" asp-for="Questions[i].AnserOptions[j].ColorCode" />

                                <div class="col-md-6">
                                    <div class="input-group input-group-sm @colores[j] shadow-sm rounded">
                                        <div class="input-group-text bg-white border-0">
                                            <input class="form-check-input mt-0" type="radio" 
                                                   name="Questions[@i].CorrectAnswerIndex" 
                                                   value="@j" 
                                                   @(Model.Questions[i].AnserOptions[j].IsCorrect ? "checked" : "") required>
                                            
                                            <input type="hidden" asp-for="Questions[i].AnserOptions[j].IsCorrect" class="hidden-correct-@j" />
                                        </div>
                                        @if (j < 2)
                                        {
                                            <input type="text" asp-for="Questions[i].AnserOptions[j].Text" class="form-control border-0 bg-light" placeholder="Opción @(j + 1)" required />
                                        }
                                        else
                                        {
                                            <input type="text" asp-for="Questions[i].AnserOptions[j].Text" class="form-control border-0 bg-light" placeholder="Opción @(j + 1)" />
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="text-end mt-4 mb-5">
            <a asp-action="Index" class="btn btn-light btn-sm me-2 border">Cancelar</a>
            <button type="submit" class="btn btn-success btn-sm px-2 shadow fw-bold">
                <i class="fas fa-save me-2"></i> Guardar Cambios
            </button>
        </div>
    </form>
       </div>
       <div class="col-lg-4 col-md-5" >

       </div>
   </div>
</div>

<template id="questionTemplate">
    <div class="card border-0 shadow-sm mb-4 question-card" id="question_{Q_INDEX}">

        <input type="hidden" name="Questions[{Q_INDEX}].QuestionId" value="0" />
        <input type="hidden" name="Questions[{Q_INDEX}].QuizId" value="@Model.QuizId" />

        <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold text-primary mb-0"><i class="fas fa-question-circle me-1"></i> Pregunta <span class="q-number">{Q_NUM}</span></h5>
            <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeQuestion({Q_INDEX})">
                <i class="fas fa-trash"></i>
            </button>
        </div>

        <div class="card-body p-4">
            <div class="mb-4">
                <input type="text" name="Questions[{Q_INDEX}].Text" class="form-control form-control-lg border-2" placeholder="Escribe la pregunta aquí..." required />
            </div>

            <div class="row g-3 mb-4 text-muted small">
                <div class="col-md-6 d-flex align-items-center">
                    <i class="fas fa-stopwatch me-2 fs-5"></i>
                    <select name="Questions[{Q_INDEX}].TimeLimitSecond" class="form-select form-select-sm w-auto border-0 bg-light fw-bold">
                        <option value="10">10 Segundos</option>
                        <option value="20" selected>20 Segundos</option>
                        <option value="30">30 Segundos</option>
                        <option value="60">1 Minuto</option>
                    </select>
                </div>
                <div class="col-md-6 d-flex align-items-center justify-content-end">
                    <i class="fas fa-star me-2 fs-5 text-warning"></i>
                    <input type="number" name="Questions[{Q_INDEX}].Point" value="1000" class="form-control form-control-sm w-auto border-0 bg-light fw-bold" /> pts
                </div>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <div class="input-group input-group-lg ans-red shadow-sm rounded">
                        <div class="input-group-text bg-white border-0">
                            <input class="form-check-input mt-0" type="radio" name="Questions[{Q_INDEX}].CorrectAnswerIndex" value="0" required>
                            <input type="hidden" name="Questions[{Q_INDEX}].AnserOptions[0].IsCorrect" value="false" class="hidden-correct-0" />
                            <input type="hidden" name="Questions[{Q_INDEX}].AnserOptions[0].ColorCode" value="#E21B3C" />
                            <input type="hidden" name="Questions[{Q_INDEX}].AnserOptions[0].AnwerOptionId" value="0" />
                        </div>
                        <input type="text" name="Questions[{Q_INDEX}].AnserOptions[0].Text" class="form-control border-0 bg-light" placeholder="Opción 1" required />
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="input-group input-group-lg ans-blue shadow-sm rounded">
                        <div class="input-group-text bg-white border-0">
                            <input class="form-check-input mt-0" type="radio" name="Questions[{Q_INDEX}].CorrectAnswerIndex" value="1" required>
                            <input type="hidden" name="Questions[{Q_INDEX}].AnserOptions[1].IsCorrect" value="false" class="hidden-correct-1" />
                            <input type="hidden" name="Questions[{Q_INDEX}].AnserOptions[1].ColorCode" value="#1368CE" />
                            <input type="hidden" name="Questions[{Q_INDEX}].AnserOptions[1].AnwerOptionId" value="0" />
                        </div>
                        <input type="text" name="Questions[{Q_INDEX}].AnserOptions[1].Text" class="form-control border-0 bg-light" placeholder="Opción 2" required />
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="input-group input-group-lg ans-yellow shadow-sm rounded">
                        <div class="input-group-text bg-white border-0">
                            <input class="form-check-input mt-0" type="radio" name="Questions[{Q_INDEX}].CorrectAnswerIndex" value="2" required>
                            <input type="hidden" name="Questions[{Q_INDEX}].AnserOptions[2].IsCorrect" value="false" class="hidden-correct-2" />
                            <input type="hidden" name="Questions[{Q_INDEX}].AnserOptions[2].ColorCode" value="#D89E00" />
                            <input type="hidden" name="Questions[{Q_INDEX}].AnserOptions[2].AnwerOptionId" value="0" />
                        </div>
                        <input type="text" name="Questions[{Q_INDEX}].AnserOptions[2].Text" class="form-control border-0 bg-light" placeholder="Opción 3 (Opcional)" />
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="input-group input-group-lg ans-green shadow-sm rounded">
                        <div class="input-group-text bg-white border-0">
                            <input class="form-check-input mt-0" type="radio" name="Questions[{Q_INDEX}].CorrectAnswerIndex" value="3" required>
                            <input type="hidden" name="Questions[{Q_INDEX}].AnserOptions[3].IsCorrect" value="false" class="hidden-correct-3" />
                            <input type="hidden" name="Questions[{Q_INDEX}].AnserOptions[3].ColorCode" value="#26890C" />
                            <input type="hidden" name="Questions[{Q_INDEX}].AnserOptions[3].AnwerOptionId" value="0" />
                        </div>
                        <input type="text" name="Questions[{Q_INDEX}].AnserOptions[3].Text" class="form-control border-0 bg-light" placeholder="Opción 4 (Opcional)" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</template>

@section Scripts {
    <script>
        // TRUCO: A diferencia de Create, aquí iniciamos el conteo en la cantidad de preguntas que ya existen en la BD.
        let questionCount = @Model.Questions.Count;

        function addQuestion() {
            const template = document.getElementById('questionTemplate').innerHTML;
            const finalHtml = template
                .replace(/{Q_INDEX}/g, questionCount)
                .replace(/{Q_NUM}/g, questionCount + 1);

            document.getElementById('questionsContainer').insertAdjacentHTML('beforeend', finalHtml);
            questionCount++;
        }

        function removeQuestion(index) {
            if (document.querySelectorAll('.question-card').length <= 1) {
                Swal.fire({title: "Aviso",text: "El cuestionario debe tener al menos una pregunta.", icon: "error"});
                return;
            }

            const element = document.getElementById('question_' + index);
            if (element) {
                // Al eliminar en el DOM, el HTML no se enviará al servidor.
                // En el POST de C# detectaremos que falta y lo borraremos de la BD.
                element.remove();
                reindexQuestions();
            }
        }

        // Pega aquí las mismas funciones reindexQuestions() y el event listener del 'submit'
        // idénticas a las que tienes en Create.cshtml
        // ...
        function reindexQuestions() {
            const questions = document.querySelectorAll('.question-card');

            questions.forEach((card, index) => {
                // 1. Actualizar el ID principal de la tarjeta
                card.id = `question_${index}`;

                // 2. Actualizar el número visual (Pregunta 1, Pregunta 2...)
                card.querySelector('.q-number').innerText = index + 1;

                // 3. Actualizar el botón de basurero para que apunte al índice correcto
                const deleteBtn = card.querySelector('.btn-outline-danger');
                deleteBtn.setAttribute('onclick', `removeQuestion(${index})`);

                // 4. Actualizar todos los nombres (name) de los inputs para C#
                // Cambia algo como name="Questions[3].Text" a name="Questions[1].Text"
                const inputs = card.querySelectorAll('input, select');
                inputs.forEach(input => {
                    if (input.name) {
                        input.name = input.name.replace(/Questions\[\d+\]/, `Questions[${index}]`);
                    }
                });
            });

            // Actualizamos la variable global
            questionCount = questions.length;
        }
        document.getElementById('quizForm').addEventListener('submit', function (e) {
            const questions = document.querySelectorAll('.question-card');

            questions.forEach((card, index) => {
                // Ponemos todas las respuestas en falso
                for (let i = 0; i < 4; i++) {
                    let hiddenCorrect = card.querySelector(`.hidden-correct-${i}`);
                    if (hiddenCorrect) hiddenCorrect.value = "false";
                }

                // Buscamos cuál está seleccionada como correcta y la ponemos en verdadero
                const selectedRadio = card.querySelector(`input[name="Questions[${index}].CorrectAnswerIndex"]:checked`);
                if (selectedRadio) {
                    const correctIndex = selectedRadio.value;
                    const correctHidden = card.querySelector(`.hidden-correct-${correctIndex}`);
                    if (correctHidden) {
                        correctHidden.value = "true";
                    }
                }
            });
        });
    </script>
}