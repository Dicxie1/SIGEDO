@*
    View: _AcademicPeriod.cshtml
    Description: This page desing for view de Academic Period 
    Author: Dicxie Danuard Madrigal <dicxiemadrigal@gmail.com> 
*@
@model List<AcademicPeriod>
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-4 rounded shadow-sm mt-2">
        <div>
            <h2 class="h3 mb-0 text-gray-800 font-weigth-bold"> 
                Periodo Academico
            </h2>
            <p class="text-muted"> Administracion de ciclos acadmico, finalizados  y semestre activo </p>
        </div>
        <button class="btn btn-primary shadow-sm rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#createPeriodModal">
            <i class="fas fa-calendar-plus"></i> Crear
        </button>
    </div>
    @{
        var activePeriod = Model.FirstOrDefault(p => p.Status == EnumPeriodStatus.Active);
    }
    @if(TempData["Success"] != null)
    {
        <!-- Alert succes con boton de cierre -->
        <div class="alert alert-success alert-dismissible border-0 shadow-sm d-flex align-items-center mb-4 py-3" role="alert">
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        <div>
            <i class="bi bi-check-circle-fill fs-4 me-3"></i> @TempData["Success"]
        </div>
        
        </div>
    }
    @if(TempData["Error"] != null){
         <div class="alert alert-danger border-0 shadow-sm d-flex align-items-center mb-4 py-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
        <div>
            @TempData["Error"]
        </div>
         </div>
    }
    @if ( activePeriod != null)
    {
        <div class="alert alert-primary border-0 shadow-sm d-flex align-items-center mb-4 py-3" role="alert">
            <i class="bi bi-info-circle-fill fs-4 me-3"></i>
            <div>
                <strong>Current Active Period:</strong> @activePeriod.Name
                <span class="mx-2 text-primary-emphasis">|</span>
                Ends on: @activePeriod.EndPeriod.ToShortDateString()
            </div>
        </div>
    }
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover aling-middle mb-0">
                <thead class="ps-4">
                    <tr>
                        <th class="ps-4">Periodo</th>
                        <th>Fecha Inicio</th>
                        <th>Fecha Fin</th>
                        <th>Estado</th>
                        <th class="text-end pe-4">Actiones</th>
                    </tr>
                </thead>
                <tbody>
                    @if(Model.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4">
                                <i class="bi bi-calendar-x fs-1 text-muted"></i>
                                <p class="text-muted mt-2">No se ha encontrado ningún periodo académico. crear uno nuevo precionando el boton <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createPeriodModal"> <i class="fas fa-calendar-plus"></i> Crear</button>.</p>
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model.OrderByDescending(x => x.StartPeriod))
                    {
                        
                        <tr class="@(item.Status == EnumPeriodStatus.Active ? "table-primary" : item.Status == EnumPeriodStatus.Planning ? "table-warning" : "")">
                            <td class="ps-4">
                                <span class="fw-bold d-block">@item.Name</span>
                                <small class="text-muted">Code: PER-@item.AcademicPeriodId</small>
                            </td>
                            <td>@item.StartPeriod.ToString("MMM dd, yyyy")</td>
                            <td>@item.EndPeriod.ToString("MMM dd, yyyy")</td>
                            <td>
                                @switch (item.Status)
                                {
                                    case EnumPeriodStatus.Active:
                                        <span class="badge rounded-pill bg-success-subtle text-success border border-success px-3">Active</span>
                                        break;
                                    case EnumPeriodStatus.Planning:
                                        <span class="badge rounded-pill bg-warning-subtle text-warning border border-warning px-3">Planning</span>
                                        break;
                                    case EnumPeriodStatus.Closed:
                                        <span class="badge rounded-pill bg-secondary-subtle text-secondary border border-secondary px-3">Closed</span>
                                        break;
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group shadow-sm">
                                    <a asp-action="ActivePeriod" asp-route-id="@item.AcademicPeriodId" class="btn btn-white btn-sm border" title="Active">
                                        <i class="fas fa-calendar-check text-primary"></i>
                                    </a>
                                    @if (item.Status != EnumPeriodStatus.Active)
                                    {
                                        <!-- open edit modal -->
                                        <button class="btn btn-white btn-sm border" title="Edit" onclick="editPeriod(@item.AcademicPeriodId)">
                                        <i class="fas fa-edit text-warning"></i>
                                        </button>
                                    }
                                    <button class="btn btn-white btn-sm border" title="Archive" onclick="confirmArchive(@item.AcademicPeriodId)">
                                        <i class="fas fa-archive text-secondary"></i>
                                    </button>
                                    
                                    @if (item.Status == EnumPeriodStatus.Planning)
                                    {
                                        <button class="btn btn-white btn-sm border" title="Delete" onclick="deletePeriod(@item.AcademicPeriodId)">
                                            <i class="fas fa-trash text-danger"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<div class="modal fade" id="createPeriodModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-action="Create" method="post">
                <div class="modal-header border-bottom-0">
                    <h5 class="modal-title fw-bold">Setup New Academic Period</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Period Name</label>
                        <input name="Name" class="form-control" placeholder="e.g. Fall Semester 2026" required />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small fw-bold">Start Date</label>
                            <input type="date" name="StartPeriod" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small fw-bold">End Date</label>
                            <input type="date" name="EndPeriod" class="form-control" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4">Save Period</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Period Modal -->
<div class="modal fade" id="editPeriodModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form id="editPeriodForm" action="EditAcademicPeriod" method="post">
                <div class="modal-header border-bottom-0">
                    <h5 class="modal-title fw-bold">Edit Academic Period</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="AcademicPeriodId" id="editAcademicPeriodId" />
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Period Name</label>
                        <input name="Name" id="editName" class="form-control" required />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label
    small fw-bold">Start Date</label>
                            <input type="date" name="StartPeriod" id="editStartPeriod" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small fw-bold">End Date</label>
                            <input type="date" name="EndPeriod" id="editEndPeriod" class="form-control" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top-0">
                    <button type="button" class="btn btn-outline-danger" onclick="deletePeriod($('#editAcademicPeriodId').val())">Delete</button>
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function editPeriod(id) {
            $.get('/Course/GetAcademicPeriod/' + id, function(data) {
                let result = data.data;
                console.log(result);
                $('#editAcademicPeriodId').val(result.academicPeriodId);
                $('#editName').val(result.name);
                $('#editStartPeriod').val(result.startPeriod);
                $('#editEndPeriod').val(result.endPeriod);
                $('#editPeriodForm').attr('action', '/Course/Period/Edit/' + id);
                $('#editPeriodModal').modal('show');
            });
        }
        function confirmArchive(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "Deseas archivar este periodo academico? Esto no se podra revertir y los horarios asociados a este periodo ya no estaran activos.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Si, archivar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '/Course/Period/Active/' + id;
                }
            });
            
        }
        async function  deletePeriod(id) {
            // get acadeic period
            let response = await fetch('/Course/GetAcademicPeriod/' + id);
            const data = await response.json();
            
            if(data.data.HasSchedules)
            {
                alert('Cannot delete this period because it has associated schedules. Please archive it instead.');
                return;
            }else{
                const deletePedrio = await fetch('/Course/Period/Delete/' + id, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    }
                });
                if(deletePedrio.ok)                {
                    location.reload();
                }else{
                    Swal.fire('Error', 'An error occurred while trying to delete the period.', 'error');
                    
                }
            }
        }
    </script>
}
