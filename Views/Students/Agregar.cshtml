        /* Indica visualmente que la celda es interactiva */
        #tbodyCsvStudents td.editable-cell {
            cursor: pointer;
            position: relative;
            transition: background-color 0.15s ease;
        }

            #tbodyCsvStudents td.editable-cell:hover {
                background-color: rgba(13, 110, 253, 0.08) !important; /* Destello azul tenue */
            }

        /* Ocultar el input por defecto */
        .cell-input {
            display: none;
            width: 100%;
            padding: 2px 6px;
            border: 1px solid #0d6efd;
            border-radius: 4px;
            font-size: inherit;
        }

    </style>
}