@{
    ViewData["Title"] = "Unirse al Juego";
    Layout = "_LayoutFullscreen";
}
<style>
    /* Estilos Gamificados para Celulares */
    body {
        background-color: #003876; /* Azul Institucional como fondo */
        color: white;
    }

    .join-container {
        max-width: 400px; /* Ancho ideal para celulares */
        width: 100%;
        margin: 0 auto;
        padding: 20px;
    }

    .game-input {
        text-align: center;
        font-size: 1.5rem;
        font-weight: bold;
        padding: 15px;
        border-radius: 8px;
        border: 2px solid transparent;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        transition: all 0.3s ease;
    }

        .game-input:focus {
            border-color: #F7931E; /* Naranja institucional */
            box-shadow: 0 0 15px rgba(247, 147, 30, 0.5);
            outline: none;
        }

    /* Ocultar flechas en input de número */
    input[type=number]::-webkit-inner-spin-button,
    input[type=number]::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    .btn-join {
        background-color: #333;
        color: white;
        font-size: 1.5rem;
        font-weight: bold;
        padding: 15px;
        border-radius: 8px;
        width: 100%;
        border: none;
        transition: transform 0.1s, background-color 0.3s;
    }

        .btn-join:hover, .btn-join:focus {
            background-color: #000;
            color: white;
        }

        .btn-join:active {
            transform: translateY(4px); /* Efecto de presionar botón físico */
        }

    .avatar-preview {
        width: 110px;
        height: 110px;
        background-color: #ffffff;
        border-radius: 50%;
        border: 4px solid #F7931E;
        box-shadow: 0 8px 15px rgba(0,0,0,0.3);
        object-fit: contain;
        margin-bottom: 10px;
        transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .avatar-container {
        animation: popIn 0.5s ease-out;
    }

    @@keyframes popIn {
        0% {
            transform: scale(0);
            opacity: 0;
        }

        80% {
            transform: scale(1.1);
            opacity: 1;
        }

        100% {
            transform: scale(1);
            opacity: 1;
        }
    }
</style>

<div class="d-flex align-items-center justify-content-center vh-100">
    <div class="join-container text-center">

        <div class="mb-5">
            <i class="fas fa-gamepad fa-4x text-white mb-3 shadow-sm"></i>
            <h1 class="fw-bold tracking-widest" style="letter-spacing: 2px;">SGA QUIZ</h1>
        </div>

        <form asp-controller="StudentPlay" asp-action="JoinGame" method="post" id="joinForm">

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger fw-bold rounded-3 shadow-sm mb-4" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i> @TempData["Error"]
                </div>
            }

            <div class="mb-3">
                <input type="number"
                       class="form-control game-input"
                       id="pin"
                       name="pin"
                       placeholder="PIN del Juego"
                       required
                       autocomplete="off">
            </div>
            <div class="avatar-container my-4">
                <img id="avatarImage" src="https://api.dicebear.com/7.x/bottts/svg?seed=SGA" alt="Tu Avatar" class="avatar-preview" />
               
            </div>
            <input type="hidden" id="avatarUrl" name="avatarUrl" value="https://api.dicebear.com/7.x/bottts/svg?seed=SGA" />
            <div class="mb-4">
                <input type="text"
                       class="form-control game-input"
                       id="nickname"
                       name="nickname"
                       placeholder="Tu Nombre"
                       maxlength="15"
                       required
                       autocomplete="off">
            </div>

            <button type="submit" class="btn-join shadow">Ingresar</button>
        </form>

        <div class="mt-5 text-white-50 small">
            <p>Asegúrate de ver tu nombre en la pantalla del profesor.</p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Pequeño script para que al escribir el PIN de 6 dígitos, pase automáticamente al campo del nombre
        document.getElementById('pin').addEventListener('input', function (e) {
            if (this.value.length >= 6) {
                this.value = this.value.slice(0, 6); // Limitar a 6
                document.getElementById('nickname').focus();
            }
        });
        // 2. Magia del Avatar: Generar avatar robótico dinámico mientras escribe
        const nicknameInput = document.getElementById('nickname');
        const avatarImage = document.getElementById('avatarImage');
        const avatarUrlInput = document.getElementById('avatarUrl');

        nicknameInput.addEventListener('input', function () {
            let seed = this.value.trim();

            // Si borra todo, le ponemos uno por defecto
            if (seed === "") {
                seed = "SGA";
            }

            // Usamos la API de DiceBear (estilo 'bottts' genera robots divertidos)
            const newAvatarUrl = `https://api.dicebear.com/7.x/bottts/svg?seed=${encodeURIComponent(seed)}`;

            // Cambiamos la imagen visible y damos un pequeño efecto de rebote
            avatarImage.src = newAvatarUrl;
            avatarImage.style.transform = "scale(1.15)";
            setTimeout(() => { avatarImage.style.transform = "scale(1)"; }, 150);

            // Guardamos la URL en el input oculto para que se vaya en el form POST
            avatarUrlInput.value = newAvatarUrl;
        });
    </script>
}
