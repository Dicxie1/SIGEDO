    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
                <nav class="col-md-2 d-none d-md-block sidebar bg-white min-vh-100">
                <div class="position-sticky">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link active" asp-controller="Dashboard" asp-action="Index"><i class="fas fa-home"></i> Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"  asp-controller="Subject" asp-action="Index"><i class="fas fa-book"></i> Asignaturas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"  asp-controller="Course" asp-action="Admin"><i class="fas fa-door-open"></i> Curso</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Students" asp-action="Index"><i class="fas fa-users-gear"></i> Estudiantes</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Classroom" asp-action="Index" ><i class="fas fa-chalkboard-user"></i> Aulas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#"><i class="fas fa-chart-bar"></i> Reportes</a>
                        </li>
