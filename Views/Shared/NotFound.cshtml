@{
    ViewData["Title"] = "Página no encontrada";
    // Usamos el layout principal para que no pierda el menú lateral del sistema
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 75vh;">
    <div class="col-md-8 col-lg-6 text-center">
        <div class="position-relative mb-4 d-inline-block">
            <i class="fas fa-map-marked-alt text-primary opacity-25" style="font-size: 8rem;"></i>
            <span class="position-absolute top-50 start-50 translate-middle fw-bold text-dark" style="font-size: 3rem; text-shadow: 2px 2px 4px rgba(255,255,255,0.8);">
                404
            </span>
        </div>

        <h2 class="fw-bold text-dark mb-3">¡Ruta no encontrada!</h2>
        
        <p class="text-muted mb-4 fs-5">
            La página que intentas consultar no existe, fue movida o simplemente no forma parte del syllabus de este semestre.
        </p>

        <div class="card border-0 shadow-sm rounded-4 bg-light mb-4 text-start">
            <div class="card-body p-3">
                <p class="mb-1 small fw-bold text-muted"><i class="fas fa-search me-2"></i>Causas comunes:</p>
                <ul class="mb-0 small text-muted">
                    <li>La URL fue escrita incorrectamente.</li>
                    <li>El curso o trabajo fue archivado/eliminado.</li>
                    <li>El enlace en el que hiciste clic está caducado.</li>
                </ul>
            </div>
        </div>

        <div class="d-flex justify-content-center gap-3">
            <button onclick="history.back()" class="btn btn-outline-secondary fw-bold rounded-pill px-4">
                <i class="fas fa-arrow-left me-2"></i> Volver atrás
            </button>
            
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary fw-bold rounded-pill px-4 shadow-sm">
                <i class="fas fa-home me-2"></i> Ir al Dashboard
            </a>
        </div>
    </div>
</div>